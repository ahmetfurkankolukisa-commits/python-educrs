---
import Base from "../layouts/Base.astro";
import Runner from "../components/Runner.svelte";
import { Button, Mascot } from "@educrs/ui";
import { t } from "@educrs/i18n";

const features = [
  { title: t("home.feature.free"), text: t("home.feature.free.text"), icon: "M12 21s-7-4.4-9.3-9A5.3 5.3 0 0 1 12 6.3 5.3 5.3 0 0 1 21.3 12C19 16.6 12 21 12 21z" },
  { title: t("home.feature.noAccount"), text: t("home.feature.noAccount.text"), icon: "M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4 21a8 8 0 0 1 16 0" },
  { title: t("home.feature.offline"), text: t("home.feature.offline.text"), icon: "M5 12.5l4.5 4.5L19 7.5" },
];
---

<Base>
  <section class="hero">
    <!-- Decoration (aria-hidden): Byte, and on wide screens a glimpse of what a lesson looks like. -->
    <div class="art" aria-hidden="true">
      <div class="preview">
        <span class="pv-chip">Predict the output</span>
        <pre class="pv-code">name = "Ada"
print("Hi", name)</pre>
        <div class="pv-choice pv-right"><span>Hi Ada</span><span>✓</span></div>
        <div class="pv-choice"><span>Hi name</span></div>
      </div>
      <div class="byte"><Mascot mood="hello" size={128} /></div>
    </div>
    <div class="intro">
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">{t("home.heading")}</h1>
      <p class="mt-4 max-w-xl text-lg text-muted">{t("home.lead")}</p>
      <div class="mt-6"><Button href="/learn/" data-testid="start-learning">{t("home.startLearning")}</Button></div>
    </div>
  </section>

  <section aria-label={t("home.features")}>
    <ul class="features">
      {
        features.map((f) => (
          <li>
            <span class="feature-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" focusable="false"><path d={f.icon} /></svg>
            </span>
            <span>
              <strong>{f.title}</strong>
              <span class="block text-sm text-muted">{f.text}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="try" class="try">
    <h2 id="try" class="text-xl font-semibold">{t("home.tryIt")}</h2>
    <p class="mt-1 text-muted">{t("home.tryIt.help")}</p>
    <div class="mt-4">
      <Runner client:visible />
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    gap: var(--space-4);
  }
  .art {
    position: relative;
    justify-self: start;
  }
  .preview {
    display: none;
  }
  .byte {
    width: 6rem;
  }
  .byte :global(svg) {
    width: 100%;
    height: auto;
  }
  @media (min-width: 720px) {
    /* Byte leans out of the art column by 2.25rem; the 3rem gap keeps it clear of the words. */
    .hero {
      grid-template-columns: minmax(0, 1fr) 16rem;
      align-items: center;
      gap: var(--space-12);
    }
    .art {
      order: 2;
      justify-self: end;
      width: 16rem;
      padding-bottom: 2.5rem;
    }
    .preview {
      display: grid;
      gap: var(--space-2);
      padding: var(--space-4);
      border: 2px solid var(--color-border-soft);
      border-bottom-width: 6px;
      border-radius: var(--radius-lg);
      background: var(--color-surface);
      rotate: 2deg;
    }
    .pv-chip {
      justify-self: start;
      padding: 0.125rem var(--space-3);
      border-radius: 999px;
      background: var(--color-accent-soft);
      color: var(--color-accent);
      font-size: 0.75rem;
      font-weight: 700;
    }
    .pv-code {
      margin: 0;
      padding: var(--space-2) var(--space-3);
      border-radius: var(--radius-sm);
      background: var(--color-code-bg);
      font: 0.8125rem / 1.5 var(--font-mono);
    }
    .pv-choice {
      display: flex;
      justify-content: space-between;
      padding: var(--space-2) var(--space-3);
      border: 2px solid var(--color-border-soft);
      border-bottom-width: 4px;
      border-radius: var(--radius-sm);
      font: 0.8125rem / 1.4 var(--font-mono);
    }
    .pv-right {
      border-color: var(--color-success);
      background: var(--color-success-soft);
      color: var(--color-text);
    }
    .byte {
      position: absolute;
      left: -2.25rem;
      bottom: -0.5rem;
      width: 7rem;
    }
  }
  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: var(--space-4);
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
  }
  .features li {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
  }
  .feature-icon {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-md);
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }
  .feature-icon svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .try {
    margin-top: var(--space-12);
  }
</style>
